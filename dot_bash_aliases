# CONSTANTS

rgb_lb="\[\033[01;34m\]"
rgb_lc="\[\033[01;36m\]"
rgb_lg="\[\033[01;32m\]"
rgb_lm="\[\033[01;35m\]"
rgb_lr="\[\033[01;31m\]"
rgb_ly="\[\033[01;33m\]"
rgb_nb="\[\033[00;34m\]"
rgb_nc="\[\033[00;36m\]"
rgb_ng="\[\033[00;32m\]"
rgb_nm="\[\033[00;35m\]"
rgb_nr="\[\033[00;31m\]"
rgb_ny="\[\033[00;33m\]"
rgb_00="\[\033[00;00m\]"



# INTERNAL FUNCTIONS

function __check_cmd()
{
    local found=$(which "$1" &> /dev/null; echo $?)

    if [ $found -ne 0 ]; then
       echo -e "$rgb_nr[error]$rgb_00 program $rgb_nc$1$rgb_00 missing$rgb_nb$url$rgb_00" | sed 's/\\\[//g;s/\\\]//g'
    fi
}

function __source()
{
    test -r "$1" && source "$1"
}



# PROMPT

__source /usr/share/git/completion/git-prompt.sh

function __branch()
{
    __git_ps1 "$rgb_ny(%s)$rgb_00 " 2> /dev/null || printf ""
}

function __result()
{
    if [ $1 -eq 0 ]; then
        echo -n "$rgb_ng"
    else
        echo -n "$rgb_nr"
    fi
    printf "[%03u]" "$1"
    echo "$rgb_00 "
}

function __time()
{
    echo "$rgb_nc\\A$rgb_00 "
}

function __userhost()
{
    local uid=$(id -u)
    if [ $uid -eq 0 ]; then
        echo "$rgb_lr\\u@\\h$rgb_00 "
    elif [[ $SSH_CONNECTION ]]; then
        echo "$rgb_nm\\u@\\h$rgb_00 "
    fi
}

function __path()
{
    echo "$rgb_lb\\w$rgb_00"
}

function __prompt()
{
    echo "${rgb_nc}\\\$${rgb_00} "
}

PROMPT_COMMAND='res=$?;PS1="\n$(__result $res)$(__time)$(__branch)$(__userhost)$(__path)\n$(__prompt)"'



